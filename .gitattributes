# Enforce LF line endings for all text files.
# NOTE: this normalises line endings only — it does NOT strip a UTF-8 BOM.
# A BOM makes a PHP file unparsable ("strict_types declaration must be the very
# first statement") and survived unnoticed in the core bundle for months. On
# Windows, write PHP files BOM-free explicitly; PowerShell's
# Set-Content -Encoding utf8 adds one.
* text=auto eol=lf

# PHP files always LF
*.php text eol=lf

# Composer / JSON always LF
*.json text eol=lf

# Markdown always LF
*.md text eol=lf

# YAML always LF
*.yaml text eol=lf
*.yml text eol=lf

# Twig templates always LF
*.twig text eol=lf

# Contao legacy templates always LF
*.html5 text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary

# Keep development-only files out of the distributed package. Without these,
# every `composer require` pulls the test suite into the consumer's vendor/.
/tests           export-ignore
/phpunit.xml.dist export-ignore
/.gitattributes  export-ignore
/.gitignore      export-ignore
