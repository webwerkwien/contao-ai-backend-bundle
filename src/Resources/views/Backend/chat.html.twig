{# `hasKey` used to mean "an API key is stored", which hid the chat from every
   self-hosted provider — Ollama needs a host, not a key. It now means "this
   profile can actually run", answered by PlatformResolver, and `blocker` carries
   the reason so the message names the missing field instead of always blaming a
   key that may not be required. #}
{% if not hasKey %}
    <div class="tl_message">
        <p class="tl_error">{{ blocker|default('tl_user.ai_api_key.1'|trans({}, 'contao_tl_user')) }}</p>
    </div>
{% else %}
    <style{% if csp_nonce('style-src') is defined %} nonce="{{ csp_nonce('style-src') }}"{% endif %}>
        .ai-chat { display: flex; flex-direction: column; gap: .75rem; margin-top: 1rem; border: 1px solid #ccc; border-radius: 6px; padding: 1rem; background: #fff; }
        .ai-chat__transcript { min-height: 12rem; max-height: 28rem; overflow-y: auto; padding: .5rem; border: 1px solid #eee; border-radius: 4px; background: #fafafa; font-size: .95rem; line-height: 1.4; }
        .ai-chat__msg { margin: 0 0 .75rem; padding: .5rem .75rem; border-radius: 4px; word-break: break-word; white-space: pre-wrap; }
        .ai-chat__msg--user { background: #e6f3ff; }
        .ai-chat__msg--assistant { background: #f3f3f3; }
        .ai-chat__msg--error { background: #fbe9e9; color: #8a1f1f; }
        .ai-chat__report { margin: -.25rem 0 .75rem; padding: .5rem .75rem; background: #f7f7f7; border: 1px solid #ddd; border-radius: 4px; }
        .ai-chat__report summary { cursor: pointer; font-weight: 600; }
        .ai-chat__report pre { margin: .5rem 0; padding: .5rem; background: #fff; border: 1px solid #e5e5e5; border-radius: 3px; overflow-x: auto; white-space: pre; font-size: .85em; }
        .ai-chat__form { display: flex; flex-direction: column; gap: .5rem; }
        .ai-chat__form textarea { width: 100%; resize: vertical; font-family: inherit; font-size: .95rem; padding: .5rem; border: 1px solid #ccc; border-radius: 4px; }
        .ai-chat__form textarea:disabled { background: #fafafa; color: #888; }
        .ai-chat__form-row { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
        .ai-chat__hint { color: #666; }
    </style>

    <div class="ai-chat" id="ai-chat-root"
         data-stream-url="{{ streamUrl|e('html_attr') }}"
         data-csrf-token="{{ csrfToken|e('html_attr') }}"
         data-platform="{{ platform|e('html_attr') }}"
         data-tool-count="{{ tools|length }}">
        <div class="ai-chat__transcript" id="ai-chat-transcript" role="log" aria-live="polite"></div>

        <form class="ai-chat__form" id="ai-chat-form">
            <textarea id="ai-chat-input" rows="3"
                      placeholder="{{ 'ai_chat.input_placeholder'|trans({}, 'contao_ai_chat') }}"
                      aria-label="{{ 'ai_chat.input_label'|trans({}, 'contao_ai_chat') }}"></textarea>
            <div class="ai-chat__form-row">
                <small class="ai-chat__hint">{{ 'ai_chat.tools_available'|trans([tools|length], 'contao_ai_chat') }} · {{ platform|slice(0, 40) }}</small>
                <button type="submit" class="tl_submit" id="ai-chat-submit">{{ 'ai_chat.send'|trans({}, 'contao_ai_chat') }}</button>
            </div>
        </form>
    </div>

    <script{% if csp_nonce('script-src') is defined %} nonce="{{ csp_nonce('script-src') }}"{% endif %}>
    {
        const root = document.getElementById('ai-chat-root');
        if (root) {
            const streamUrl = root.dataset.streamUrl;
            const csrfToken = root.dataset.csrfToken;
            const transcript = document.getElementById('ai-chat-transcript');
            const form = document.getElementById('ai-chat-form');
            const input = document.getElementById('ai-chat-input');
            const submitBtn = document.getElementById('ai-chat-submit');

            /*
             * Sichtbare Texte des Skripts. Bewusst hier gebündelt und nicht
             * einzeln unten eingesetzt: So steht an einer Stelle, was ein
             * Benutzer zu lesen bekommt, und `BilingualLabelsTest` findet die
             * Schlüssel, ohne den ganzen Code lesen zu müssen.
             *
             * `json_encode` statt Anführungszeichen von Hand — ein Apostroph in
             * einer Übersetzung würde das Skript sonst zerlegen.
             */
            const LANG = {
                reportSummary: {{ 'ai_chat.report_summary'|trans({}, 'contao_ai_chat')|json_encode|raw }},
                copy:          {{ 'ai_chat.copy'|trans({}, 'contao_ai_chat')|json_encode|raw }},
                copied:        {{ 'ai_chat.copied'|trans({}, 'contao_ai_chat')|json_encode|raw }},
                unknownError:  {{ 'ai_chat.unknown_error'|trans({}, 'contao_ai_chat')|json_encode|raw }},
            };

            const HISTORY_HARD_CAP = 60;
            const HISTORY_SEND_CAP = 30;

            const history = [];
            let busy = false;
            let activeAbort = null;

            const setBusy = (value) => {
                busy = value;
                submitBtn.disabled = value;
                input.disabled = value;
            };

            const appendMessage = (role, text) => {
                const el = document.createElement('div');
                el.classList.add('ai-chat__msg', `ai-chat__msg--${role}`);
                el.textContent = text;
                transcript.appendChild(el);
                transcript.scrollTop = transcript.scrollHeight;
                return el;
            };

            /**
             * Attaches a collapsed, copyable error report below a failed turn.
             *
             * The server has already decided what this user may see — an editor
             * gets the summary, an admin the full report. Nothing here filters,
             * and nothing here fetches: expanding is presentation only.
             *
             * textContent throughout, never innerHTML. The report carries an
             * exception message, i.e. text this installation did not author.
             */
            const appendErrorReport = (afterNode, reportText) => {
                const details = document.createElement('details');
                details.classList.add('ai-chat__report');

                const summary = document.createElement('summary');
                summary.textContent = LANG.reportSummary;
                details.appendChild(summary);

                const pre = document.createElement('pre');
                pre.textContent = reportText;
                details.appendChild(pre);

                const button = document.createElement('button');
                button.type = 'button';
                button.textContent = LANG.copy;
                button.addEventListener('click', () => {
                    const done = () => {
                        button.textContent = LANG.copied;
                        window.setTimeout(() => { button.textContent = LANG.copy; }, 2000);
                    };
                    // navigator.clipboard needs a secure context; a back end
                    // reachable over plain http would silently do nothing.
                    if (navigator.clipboard && window.isSecureContext) {
                        navigator.clipboard.writeText(reportText).then(done, () => selectFallback(pre));
                    } else {
                        selectFallback(pre);
                    }
                });
                details.appendChild(button);

                afterNode.insertAdjacentElement('afterend', details);
                transcript.scrollTop = transcript.scrollHeight;
            };

            /** Leaves the text selected so Ctrl+C works where the API does not. */
            const selectFallback = (node) => {
                const range = document.createRange();
                range.selectNodeContents(node);
                const selection = window.getSelection();
                selection.removeAllRanges();
                selection.addRange(range);
            };

            const trimHistory = () => {
                if (history.length > HISTORY_HARD_CAP) {
                    history.splice(0, history.length - HISTORY_HARD_CAP);
                }
            };

            const dispatchSseBlock = (block, onEvent) => {
                const lines = block.split('\n');
                let eventName = 'message';
                let dataRaw = '';
                for (const line of lines) {
                    if (line.startsWith('event: ')) eventName = line.slice(7).trim();
                    else if (line.startsWith('data: ')) dataRaw += (dataRaw ? '\n' : '') + line.slice(6);
                }
                if (!dataRaw) return;
                let data = {};
                try { data = JSON.parse(dataRaw); } catch (_) { data = { content: dataRaw }; }
                onEvent(eventName, data);
            };

            const postSse = async ({ payload, onEvent, onClose, onFatal, signal }) => {
                try {
                    const response = await fetch(streamUrl, {
                        method: 'POST',
                        credentials: 'same-origin',
                        signal,
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'text/event-stream',
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                        body: JSON.stringify(payload),
                    });
                    if (!response.ok) {
                        const errBody = await response.text().catch(() => '');
                        onFatal(new Error(`HTTP ${response.status}: ${errBody.slice(0, 300)}`));
                        return;
                    }
                    if (!response.body) {
                        onFatal(new Error('Response body nicht verfügbar (Streaming wird nicht unterstützt)'));
                        return;
                    }
                    const reader = response.body.getReader();
                    const decoder = new TextDecoder();
                    let buffer = '';
                    while (true) {
                        const { value, done } = await reader.read();
                        if (done) break;
                        buffer += decoder.decode(value, { stream: true });
                        let sep;
                        while ((sep = buffer.indexOf('\n\n')) !== -1) {
                            const block = buffer.slice(0, sep);
                            buffer = buffer.slice(sep + 2);
                            dispatchSseBlock(block, onEvent);
                        }
                    }
                    if (buffer.trim()) dispatchSseBlock(buffer, onEvent);
                    onClose();
                } catch (err) {
                    if (err && err.name === 'AbortError') {
                        onClose();
                        return;
                    }
                    onFatal(err);
                }
            };

            form.addEventListener('submit', (event) => {
                event.preventDefault();
                if (busy) return;
                const text = (input.value || '').trim();
                if (!text) return;

                if (activeAbort) activeAbort.abort();
                activeAbort = new AbortController();

                appendMessage('user', text);
                history.push({ role: 'user', content: text });
                trimHistory();
                input.value = '';
                setBusy(true);

                const assistantNode = appendMessage('assistant', '');
                let assistantBuffer = '';
                let appendedToHistory = false;

                postSse({
                    payload: {
                        csrfToken,
                        message: text,
                    },
                    signal: activeAbort.signal,
                    onEvent: (eventName, data) => {
                        if (eventName === 'message') {
                            assistantBuffer += String(data.content || '');
                            assistantNode.textContent = assistantBuffer;
                        } else if (eventName === 'error') {
                            assistantNode.classList.add('ai-chat__msg--error');
                            assistantNode.textContent = `[${data.kind || 'error'}] ${data.message || LANG.unknownError}`;
                            // Only tool_failed and agent_failed carry a report;
                            // access_denied, tool_refused and the config error
                            // are answers, not defects, and the server sends
                            // none for them. No client-side check needed —
                            // the absence of the field is the decision.
                            if (data.report) {
                                appendErrorReport(assistantNode, data.report);
                            }
                        } else if (eventName === 'done') {
                            history.push({ role: 'assistant', content: assistantBuffer });
                            trimHistory();
                            appendedToHistory = true;
                        }
                    },
                    onClose: () => {
                        if (!appendedToHistory && assistantBuffer) {
                            history.push({ role: 'assistant', content: assistantBuffer });
                            trimHistory();
                        }
                        setBusy(false);
                        activeAbort = null;
                    },
                    onFatal: (err) => {
                        assistantNode.classList.add('ai-chat__msg--error');
                        assistantNode.textContent = `[transport] ${err.message || err}`;
                        setBusy(false);
                        activeAbort = null;
                    },
                });
            });

            window.addEventListener('beforeunload', () => {
                if (activeAbort) activeAbort.abort();
            });
        }
    }
    </script>
{% endif %}
