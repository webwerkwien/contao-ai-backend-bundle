{
    "name": "webwerkwien/contao-ai-backend-bundle",
    "description": "Contao 5 backend module with an in-browser AI agent for editors and admins, powered by symfony/ai and contao-ai-core-bundle",
    "type": "contao-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Morgenbesser",
            "homepage": "https://web.werk.wien",
            "role": "Developer"
        }
    ],
    "keywords": ["contao", "ai", "agent", "backend", "chat", "anthropic", "claude", "automation"],
    "homepage": "https://github.com/webwerkwien/contao-ai-backend-bundle",
    "support": {
        "issues": "https://github.com/webwerkwien/contao-ai-backend-bundle/issues",
        "source": "https://github.com/webwerkwien/contao-ai-backend-bundle"
    },
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.3",
        "webwerkwien/contao-ai-core-bundle": "^0.1",
        "symfony/ai-bundle": "^0.7",
        "symfony/ai-agent": "^0.7",
        "symfony/ai-anthropic-platform": "^0.7",
        "symfony/ai-open-ai-platform": "^0.7",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/security-core": "^6.4 || ^7.0",
        "symfony/security-bundle": "^6.4 || ^7.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "Webwerkwien\\ContaoAiBackendBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webwerkwien\\ContaoAiBackendBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Webwerkwien\\ContaoAiBackendBundle\\ContaoManager\\Plugin"
    },
    "scripts": {
        "phpstan": "phpstan analyse src tests --level=6",
        "phpunit": "phpunit",
        "ci": ["@phpstan", "@phpunit"]
    }
}
