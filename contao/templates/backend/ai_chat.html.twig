{#
   The AI chat page, rendered by AiChatController.

   It lives here, in contao/templates/, because that is where Contao looks for a
   bundle's templates: `@Contao/backend/ai_chat.html.twig` can be overridden in
   templates/backend/ like any core template. Until 0.10.0 it sat in
   src/Resources/views/ under a namespace of its own, which nothing in Contao
   knows about.

   The subfolder is part of the name only because contao/templates/ carries a
   `.twig-root` marker. Without it Contao reads just the top level and drops the
   folder: on the test server this file was registered as
   `@Contao/ai_chat.html.twig`, and the controller's name did not resolve.
   Contao 6 marks its own contao/templates/ the same way; its 5.x bundles mark
   contao/templates/twig/, because their .html5 files share the directory.

   The parent is the Twig `be_main`, which Contao has from 5.7 on — the lowest
   version this bundle supports. Before 5.7 be_main existed only as a legacy
   .html5 template (checked against Contao's tags 5.3.51 to 5.6.11).
#}
{% extends '@Contao/be_main.html.twig' %}

{#
   No Turbo snapshot of this page. The back end navigates with Turbo (from 5.7),
   and a restoration visit — the browser's back button — shows the cached
   snapshot without running inline scripts: the form would be there, its submit
   handler not, and a message would reload the page instead of being sent.
   Without a snapshot, going back loads the page and the script runs.
#}
{% block meta %}
    {{ parent() }}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block main_content %}
{# `hasKey` used to mean "an API key is stored", which hid the chat from every
   self-hosted provider — Ollama needs a host, not a key. It now means "this
   profile can actually run", answered by PlatformResolver, and `blocker` carries
   the reason so the message names the missing field instead of always blaming a
   key that may not be required. #}
{% if not hasKey %}
    <div class="tl_message">
        <p class="tl_error">{{ blocker|default('tl_user.ai_api_key.1'|trans({}, 'contao_tl_user')) }}</p>
    </div>
{% else %}
    {#
       Colours come from Contao's back-end theme variables, so the chat follows the
       user's light or dark scheme (`html[data-color-scheme=dark]` switches them, in
       5.7 and 6.0 alike). Until v0.14.0 they were fixed light values: in dark mode the
       frame stayed white and the answers were pale grey on pale grey (chat test,
       2026-10-10). The second value of each var() is only the fallback for a theme
       without them.
    #}
    <style{% if csp_nonce('style-src') is defined %} nonce="{{ csp_nonce('style-src') }}"{% endif %}>
        .ai-chat { display: flex; flex-direction: column; gap: .75rem; margin-top: 1rem; border: 1px solid var(--content-border, #ccc); border-radius: 6px; padding: 1rem; background: var(--content-bg, #fff); color: var(--text, #222); }
        .ai-chat__transcript { min-height: 12rem; max-height: 28rem; overflow-y: auto; padding: .5rem; border: 1px solid var(--border, #eee); border-radius: 4px; background: var(--body-bg, #fafafa); font-size: .95rem; line-height: 1.45; }
        .ai-chat__msg { margin: 0 0 .75rem; padding: .5rem .75rem; border-radius: 4px; word-break: break-word; white-space: pre-wrap; }
        .ai-chat__msg--user { background: var(--info-bg, #e6f3ff); }
        .ai-chat__msg--assistant { background: var(--panel-bg, #f3f3f3); }
        .ai-chat__msg--error { background: var(--error-bg, #fbe9e9); color: var(--red, #8a1f1f); }
        .ai-chat__msg--md { white-space: normal; }
        .ai-chat__msg--md > :first-child { margin-top: 0; }
        .ai-chat__msg--md > :last-child { margin-bottom: 0; }
        .ai-chat__msg--md p, .ai-chat__msg--md ul, .ai-chat__msg--md ol, .ai-chat__msg--md pre, .ai-chat__msg--md table, .ai-chat__msg--md blockquote { margin: 0 0 .6rem; }
        .ai-chat__msg--md h3, .ai-chat__msg--md h4, .ai-chat__msg--md h5, .ai-chat__msg--md h6 { margin: .8rem 0 .4rem; font-size: 1em; font-weight: 600; }
        .ai-chat__msg--md h3 { font-size: 1.1em; }
        .ai-chat__msg--md ul, .ai-chat__msg--md ol { padding-left: 1.4rem; }
        .ai-chat__msg--md ul { list-style: disc; }
        .ai-chat__msg--md ol { list-style: decimal; }
        .ai-chat__msg--md li { margin: .15rem 0; }
        .ai-chat__msg--md li > ul, .ai-chat__msg--md li > ol { margin: .15rem 0 0; }
        .ai-chat__msg--md code { padding: .05rem .3rem; border-radius: 3px; background: var(--code-bg, #eee); font-size: .9em; }
        .ai-chat__msg--md pre { padding: .5rem; border-radius: 4px; background: var(--code-bg, #eee); overflow-x: auto; white-space: pre; }
        .ai-chat__msg--md pre code { padding: 0; background: none; }
        .ai-chat__msg--md table { border-collapse: collapse; display: block; overflow-x: auto; }
        .ai-chat__msg--md th, .ai-chat__msg--md td { padding: .25rem .5rem; border: 1px solid var(--border, #ddd); text-align: left; vertical-align: top; }
        .ai-chat__msg--md th { background: var(--table-header, #f6f6f8); font-weight: 600; }
        .ai-chat__msg--md blockquote { padding-left: .75rem; border-left: 3px solid var(--border, #ddd); color: var(--gray, #666); }
        .ai-chat__msg--md hr { border: 0; border-top: 1px solid var(--border, #ddd); margin: .6rem 0; }
        .ai-chat__msg--md a { color: var(--blue, #006494); text-decoration: underline; }
        .ai-chat__report { margin: -.25rem 0 .75rem; padding: .5rem .75rem; background: var(--panel-bg, #f7f7f7); border: 1px solid var(--border, #ddd); border-radius: 4px; }
        .ai-chat__report summary { cursor: pointer; font-weight: 600; }
        .ai-chat__report pre { margin: .5rem 0; padding: .5rem; background: var(--code-bg, #fff); border: 1px solid var(--border, #e5e5e5); border-radius: 3px; overflow-x: auto; white-space: pre; font-size: .85em; }
        .ai-chat__form { display: flex; flex-direction: column; gap: .5rem; }
        .ai-chat__form textarea { width: 100%; resize: vertical; font-family: inherit; font-size: .95rem; padding: .5rem; border: 1px solid var(--form-border, #ccc); border-radius: 4px; background: var(--form-bg, #fff); color: var(--text, #222); }
        .ai-chat__form textarea:disabled { background: var(--form-bg-hover, #fafafa); color: var(--form-text-disabled, #888); }
        .ai-chat__form-row { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
        .ai-chat__hint { color: var(--gray, #666); }
    </style>

    <div class="ai-chat" id="ai-chat-root"
         data-stream-url="{{ streamUrl|e('html_attr') }}"
         data-csrf-token="{{ csrfToken|e('html_attr') }}"
         data-platform="{{ platform|e('html_attr') }}"
         data-tool-count="{{ tools|length }}">
        <div class="ai-chat__transcript" id="ai-chat-transcript" role="log" aria-live="polite"></div>

        <form class="ai-chat__form" id="ai-chat-form">
            <textarea id="ai-chat-input" rows="3"
                      placeholder="{{ 'ai_chat.input_placeholder'|trans({}, 'contao_ai_chat') }}"
                      aria-label="{{ 'ai_chat.input_label'|trans({}, 'contao_ai_chat') }}"></textarea>
            <div class="ai-chat__form-row">
                <small class="ai-chat__hint">{{ 'ai_chat.tools_available'|trans([tools|length], 'contao_ai_chat') }} · {{ platform|slice(0, 40) }}</small>
                <button type="submit" class="tl_submit" id="ai-chat-submit">{{ 'ai_chat.send'|trans({}, 'contao_ai_chat') }}</button>
            </div>
        </form>
    </div>

    <script{% if csp_nonce('script-src') is defined %} nonce="{{ csp_nonce('script-src') }}"{% endif %}>
    {
        const root = document.getElementById('ai-chat-root');
        if (root) {
            const streamUrl = root.dataset.streamUrl;
            const csrfToken = root.dataset.csrfToken;
            const transcript = document.getElementById('ai-chat-transcript');
            const form = document.getElementById('ai-chat-form');
            const input = document.getElementById('ai-chat-input');
            const submitBtn = document.getElementById('ai-chat-submit');

            /*
             * Sichtbare Texte des Skripts. Bewusst hier gebündelt und nicht
             * einzeln unten eingesetzt: So steht an einer Stelle, was ein
             * Benutzer zu lesen bekommt, und `BilingualLabelsTest` findet die
             * Schlüssel, ohne den ganzen Code lesen zu müssen.
             *
             * `json_encode` statt Anführungszeichen von Hand — ein Apostroph in
             * einer Übersetzung würde das Skript sonst zerlegen.
             */
            const LANG = {
                reportSummary: {{ 'ai_chat.report_summary'|trans({}, 'contao_ai_chat')|json_encode|raw }},
                copy:          {{ 'ai_chat.copy'|trans({}, 'contao_ai_chat')|json_encode|raw }},
                copied:        {{ 'ai_chat.copied'|trans({}, 'contao_ai_chat')|json_encode|raw }},
                unknownError:  {{ 'ai_chat.unknown_error'|trans({}, 'contao_ai_chat')|json_encode|raw }},
            };

            const HISTORY_HARD_CAP = 60;
            const HISTORY_SEND_CAP = 30;

            const history = [];
            let busy = false;
            let activeAbort = null;

            const setBusy = (value) => {
                busy = value;
                submitBtn.disabled = value;
                input.disabled = value;
            };

            const appendMessage = (role, text) => {
                const el = document.createElement('div');
                el.classList.add('ai-chat__msg', `ai-chat__msg--${role}`);
                el.textContent = text;
                transcript.appendChild(el);
                transcript.scrollTop = transcript.scrollHeight;
                return el;
            };

            /**
             * Attaches a collapsed, copyable error report below a failed turn.
             *
             * The server has already decided what this user may see — an editor
             * gets the summary, an admin the full report. Nothing here filters,
             * and nothing here fetches: expanding is presentation only.
             *
             * textContent throughout, never innerHTML. The report carries an
             * exception message, i.e. text this installation did not author.
             */
            const appendErrorReport = (afterNode, reportText) => {
                const details = document.createElement('details');
                details.classList.add('ai-chat__report');

                const summary = document.createElement('summary');
                summary.textContent = LANG.reportSummary;
                details.appendChild(summary);

                const pre = document.createElement('pre');
                pre.textContent = reportText;
                details.appendChild(pre);

                const button = document.createElement('button');
                button.type = 'button';
                button.textContent = LANG.copy;
                button.addEventListener('click', () => {
                    const done = () => {
                        button.textContent = LANG.copied;
                        window.setTimeout(() => { button.textContent = LANG.copy; }, 2000);
                    };
                    // navigator.clipboard needs a secure context; a back end
                    // reachable over plain http would silently do nothing.
                    if (navigator.clipboard && window.isSecureContext) {
                        navigator.clipboard.writeText(reportText).then(done, () => selectFallback(pre));
                    } else {
                        selectFallback(pre);
                    }
                });
                details.appendChild(button);

                afterNode.insertAdjacentElement('afterend', details);
                transcript.scrollTop = transcript.scrollHeight;
            };

            /** Leaves the text selected so Ctrl+C works where the API does not. */
            const selectFallback = (node) => {
                const range = document.createRange();
                range.selectNodeContents(node);
                const selection = window.getSelection();
                selection.removeAllRanges();
                selection.addRange(range);
            };

            /* markdown:start */
            /**
             * The model's answer as Markdown (v0.14.0) — a small renderer of our own,
             * decided with the maintainer on 2026-10-11 over a library.
             *
             * Every node is built with createElement and filled with textContent;
             * there is no innerHTML anywhere on this page, so HTML in an answer — an
             * answer can quote page content, i.e. text this installation did not
             * author — stays visible text. Covered: headings, paragraphs, **bold**,
             * *italic*, `code`, fenced code blocks, lists (one level of nesting),
             * tables, quotes, rules, links. A link opens only for http(s) and for
             * paths on this host; anything else stays text.
             */
            const renderMarkdown = (source) => {
                const doc = document;
                const frag = doc.createDocumentFragment();
                const lines = String(source).replace(/\r\n?/g, '\n').split('\n');

                const el = (tag, text) => {
                    const node = doc.createElement(tag);
                    if (text !== undefined) node.textContent = text;
                    return node;
                };

                const safeHref = (url) => {
                    const u = url.trim();
                    if (/^https?:\/\//i.test(u)) return u;
                    if (u.startsWith('/') && !u.startsWith('//')) return u;
                    return null;
                };

                // Inline: the earliest match wins; code first, its content is literal.
                const INLINE = [
                    { re: /`([^`\n]+)`/, make: (m) => el('code', m[1]) },
                    { re: /\[([^\]\n]+)\]\(([^)\s]+)\)/, make: (m) => {
                        const href = safeHref(m[2]);
                        if (!href) return doc.createTextNode(`${m[1]} (${m[2]})`);
                        const a = el('a');
                        a.href = href;
                        a.target = '_blank';
                        a.rel = 'noopener noreferrer';
                        inline(a, m[1]);
                        return a;
                    } },
                    { re: /\*\*([^*\n]+?)\*\*|__([^_\n]+?)__/, make: (m) => { const s = el('strong'); inline(s, m[1] ?? m[2]); return s; } },
                    { re: /(?<![\w*])\*([^*\n]+?)\*(?!\w)|(?<![\w_])_([^_\n]+?)_(?![\w])/, make: (m) => { const e = el('em'); inline(e, m[1] ?? m[2]); return e; } },
                ];

                const inline = (parent, text) => {
                    let rest = text;
                    while (rest) {
                        let best = null;
                        for (const rule of INLINE) {
                            const m = rule.re.exec(rest);
                            if (m && (best === null || m.index < best.m.index)) best = { m, rule };
                        }
                        if (!best) { parent.appendChild(doc.createTextNode(rest)); return; }
                        if (best.m.index > 0) parent.appendChild(doc.createTextNode(rest.slice(0, best.m.index)));
                        parent.appendChild(best.rule.make(best.m));
                        rest = rest.slice(best.m.index + best.m[0].length);
                    }
                };

                const isTableRow = (l) => /^\s*\|.*\|\s*$/.test(l);
                const isTableSep = (l) => /^\s*\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)*\|?\s*$/.test(l);
                const cells = (l) => l.trim().replace(/^\||\|$/g, '').split('|').map((c) => c.trim());
                const LIST = /^(\s*)([-*+]|\d+[.)])\s+(.*)$/;

                let i = 0;
                let para = [];
                const flushPara = () => {
                    if (!para.length) return;
                    const p = el('p');
                    para.forEach((line, n) => {
                        if (n) p.appendChild(el('br'));
                        inline(p, line);
                    });
                    frag.appendChild(p);
                    para = [];
                };

                while (i < lines.length) {
                    const line = lines[i];

                    if (/^\s*```/.test(line)) {
                        flushPara();
                        const body = [];
                        i++;
                        while (i < lines.length && !/^\s*```/.test(lines[i])) body.push(lines[i++]);
                        i++; // closing fence (or end of a still streaming answer)
                        const pre = el('pre');
                        pre.appendChild(el('code', body.join('\n')));
                        frag.appendChild(pre);
                        continue;
                    }

                    if (!line.trim()) { flushPara(); i++; continue; }

                    const heading = /^(#{1,6})\s+(.*?)\s*#*\s*$/.exec(line);
                    if (heading) {
                        flushPara();
                        const h = el(`h${Math.min(6, heading[1].length + 2)}`);
                        inline(h, heading[2]);
                        frag.appendChild(h);
                        i++;
                        continue;
                    }

                    if (/^\s*([-*_])(\s*\1){2,}\s*$/.test(line)) { flushPara(); frag.appendChild(el('hr')); i++; continue; }

                    if (isTableRow(line) && i + 1 < lines.length && isTableSep(lines[i + 1])) {
                        flushPara();
                        const table = el('table');
                        const head = el('thead');
                        const tr = el('tr');
                        cells(line).forEach((c) => { const th = el('th'); inline(th, c); tr.appendChild(th); });
                        head.appendChild(tr);
                        table.appendChild(head);
                        const body = el('tbody');
                        i += 2;
                        while (i < lines.length && isTableRow(lines[i])) {
                            const row = el('tr');
                            cells(lines[i]).forEach((c) => { const td = el('td'); inline(td, c); row.appendChild(td); });
                            body.appendChild(row);
                            i++;
                        }
                        table.appendChild(body);
                        frag.appendChild(table);
                        continue;
                    }

                    if (/^\s*>\s?/.test(line)) {
                        flushPara();
                        const quote = el('blockquote');
                        const quoted = [];
                        while (i < lines.length && /^\s*>\s?/.test(lines[i])) quoted.push(lines[i++].replace(/^\s*>\s?/, ''));
                        quoted.forEach((q, n) => { if (n) quote.appendChild(el('br')); inline(quote, q); });
                        frag.appendChild(quote);
                        continue;
                    }

                    if (LIST.test(line)) {
                        flushPara();
                        const first = LIST.exec(line);
                        const ordered = /\d/.test(first[2]);
                        const list = el(ordered ? 'ol' : 'ul');
                        const baseIndent = first[1].length;
                        let item = null;
                        let sub = null;
                        while (i < lines.length) {
                            const m = LIST.exec(lines[i]);
                            if (m && m[1].length <= baseIndent + 1) {
                                item = el('li');
                                inline(item, m[3]);
                                list.appendChild(item);
                                sub = null;
                            } else if (m && item) {
                                if (!sub) { sub = el(/\d/.test(m[2]) ? 'ol' : 'ul'); item.appendChild(sub); }
                                const li = el('li');
                                inline(li, m[3]);
                                sub.appendChild(li);
                            } else if (lines[i].trim() && /^\s{2,}\S/.test(lines[i]) && item) {
                                // An indented line continues the item above it.
                                const target = sub ? sub.lastChild : item;
                                target.appendChild(doc.createTextNode(' '));
                                inline(target, lines[i].trim());
                            } else {
                                break;
                            }
                            i++;
                        }
                        frag.appendChild(list);
                        continue;
                    }

                    para.push(line);
                    i++;
                }
                flushPara();

                return frag;
            };
            /* markdown:end */

            const showMarkdown = (node, text) => {
                node.classList.add('ai-chat__msg--md');
                node.replaceChildren(renderMarkdown(text));
            };

            const trimHistory = () => {
                if (history.length > HISTORY_HARD_CAP) {
                    history.splice(0, history.length - HISTORY_HARD_CAP);
                }
            };

            const dispatchSseBlock = (block, onEvent) => {
                const lines = block.split('\n');
                let eventName = 'message';
                let dataRaw = '';
                for (const line of lines) {
                    if (line.startsWith('event: ')) eventName = line.slice(7).trim();
                    else if (line.startsWith('data: ')) dataRaw += (dataRaw ? '\n' : '') + line.slice(6);
                }
                if (!dataRaw) return;
                let data = {};
                try { data = JSON.parse(dataRaw); } catch (_) { data = { content: dataRaw }; }
                onEvent(eventName, data);
            };

            const postSse = async ({ payload, onEvent, onClose, onFatal, signal }) => {
                try {
                    const response = await fetch(streamUrl, {
                        method: 'POST',
                        credentials: 'same-origin',
                        signal,
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'text/event-stream',
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                        body: JSON.stringify(payload),
                    });
                    if (!response.ok) {
                        const errBody = await response.text().catch(() => '');
                        onFatal(new Error(`HTTP ${response.status}: ${errBody.slice(0, 300)}`));
                        return;
                    }
                    if (!response.body) {
                        onFatal(new Error('Response body nicht verfügbar (Streaming wird nicht unterstützt)'));
                        return;
                    }
                    const reader = response.body.getReader();
                    const decoder = new TextDecoder();
                    let buffer = '';
                    while (true) {
                        const { value, done } = await reader.read();
                        if (done) break;
                        buffer += decoder.decode(value, { stream: true });
                        let sep;
                        while ((sep = buffer.indexOf('\n\n')) !== -1) {
                            const block = buffer.slice(0, sep);
                            buffer = buffer.slice(sep + 2);
                            dispatchSseBlock(block, onEvent);
                        }
                    }
                    if (buffer.trim()) dispatchSseBlock(buffer, onEvent);
                    onClose();
                } catch (err) {
                    if (err && err.name === 'AbortError') {
                        onClose();
                        return;
                    }
                    onFatal(err);
                }
            };

            form.addEventListener('submit', (event) => {
                event.preventDefault();
                if (busy) return;
                const text = (input.value || '').trim();
                if (!text) return;

                if (activeAbort) activeAbort.abort();
                activeAbort = new AbortController();

                appendMessage('user', text);
                history.push({ role: 'user', content: text });
                trimHistory();
                input.value = '';
                setBusy(true);

                const assistantNode = appendMessage('assistant', '');
                let assistantBuffer = '';
                let appendedToHistory = false;

                postSse({
                    payload: {
                        csrfToken,
                        message: text,
                    },
                    signal: activeAbort.signal,
                    onEvent: (eventName, data) => {
                        if (eventName === 'message') {
                            assistantBuffer += String(data.content || '');
                            // Re-rendered whole on every chunk: a half-arrived
                            // `**` or table has to become right once the rest comes.
                            showMarkdown(assistantNode, assistantBuffer);
                        } else if (eventName === 'error') {
                            // Errors stay plain text: they carry messages this
                            // installation did not author, and no formatting.
                            assistantNode.classList.remove('ai-chat__msg--md');
                            assistantNode.classList.add('ai-chat__msg--error');
                            assistantNode.textContent = `[${data.kind || 'error'}] ${data.message || LANG.unknownError}`;
                            // Only tool_failed and agent_failed carry a report;
                            // access_denied, tool_refused and the config error
                            // are answers, not defects, and the server sends
                            // none for them. No client-side check needed —
                            // the absence of the field is the decision.
                            if (data.report) {
                                appendErrorReport(assistantNode, data.report);
                            }
                        } else if (eventName === 'done') {
                            history.push({ role: 'assistant', content: assistantBuffer });
                            trimHistory();
                            appendedToHistory = true;
                        }
                    },
                    onClose: () => {
                        if (!appendedToHistory && assistantBuffer) {
                            history.push({ role: 'assistant', content: assistantBuffer });
                            trimHistory();
                        }
                        setBusy(false);
                        activeAbort = null;
                    },
                    onFatal: (err) => {
                        assistantNode.classList.remove('ai-chat__msg--md');
                        assistantNode.classList.add('ai-chat__msg--error');
                        assistantNode.textContent = `[transport] ${err.message || err}`;
                        setBusy(false);
                        activeAbort = null;
                    },
                });
            });

            // The back end navigates with Turbo (Contao 5.7 and 6), and a Turbo
            // visit never fires beforeunload: leaving the chat through the menu
            // would keep the stream — and the agent run behind it — going. Both
            // events, so a full page load and a Turbo visit end it alike.
            //
            // `turbo:visit`, not `turbo:before-visit`: Turbo fires it when any
            // visit starts, the back and forward buttons included, and it cannot
            // be cancelled. `turbo:before-visit` comes only for links and forms
            // (a history step skips it), and a visit another listener cancels
            // would have aborted the answer and disarmed the page for nothing.
            // Read in Contao 5.7's bundled Turbo: visitStarted() dispatches it.
            //
            // Both listeners remove themselves when either fires. window and
            // document outlive a Turbo visit, so without that every visit to
            // this page would leave one more pair behind.
            const onLeave = () => {
                if (activeAbort) activeAbort.abort();
                window.removeEventListener('beforeunload', onLeave);
                document.removeEventListener('turbo:visit', onLeave);
            };
            window.addEventListener('beforeunload', onLeave);
            document.addEventListener('turbo:visit', onLeave);
        }
    }
    </script>
{% endif %}
{% endblock %}
